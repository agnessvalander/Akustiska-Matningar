%% Akustiska mätningar LAB 2 - Structural Loss Factor
% Theos och Agnes kod

clear
close all
clc

%Settings
% Assumed mass of one plate section
ms = 6.5/6;       % [kg]

% Folder
dataFolder = fullfile(fileparts(mfilename('fullpath')), ...
    'Labb2_riktig_data', 'pim');

% Frequency range according to the lab instructions
f_min = 125;  % [Hz]
f_max = 5000; % [Hz]



%% Test file path

%inputFile = fullfile(dataFolder, ...
    %'ex3_input_accelerance_v201_60_6000hz_ex.dat');
inputFile = fullfile(dataFolder, ...
    'pim_input_acc_front.dat');

[~, inputSpectra] = readMWLdaq_LV(inputFile, 'spectra');

fieldnames(inputSpectra);


%% 2. Extract 1/3-octave magnitude and phase

% Magnitude
Hii_mag_data = inputSpectra.sig_2_1_3OCT0;


% Phase
Hii_phase_data = inputSpectra.sig_3_Phi0;

% % Frequency
% f = Hii_mag_data(:,1);
% 
% % Select frequency range 125-5000 Hz
% freqMask = f >= f_min & f <= f_max;
% f = f(freqMask);
% 
% % Magnitude
% Hii_mag = Hii_mag_data(freqMask,2);
% 
% % Phase in degrees
% Hii_phase_deg = Hii_phase_data(freqMask,2);

% Frequency and magnitude
Hii_freq = Hii_mag_data(:,1);
Hii_mag_all = Hii_mag_data(:,2);

% Phase data
phase_freq = Hii_phase_data(:,1);
phase_deg = Hii_phase_data(:,2);

% Keep only 125-5000 Hz
freqMask = Hii_freq >= f_min & Hii_freq <= f_max;

f = Hii_freq(freqMask);
Hii_mag = Hii_mag_all(freqMask);

% Interpolate phase to the 1/3-octave frequencies
Hii_phase_deg = interp1(phase_freq, phase_deg, f);


%% 3. Convert Hii from magnitude + phase to complex form

Hii_phase_rad = deg2rad(Hii_phase_deg);

Hii = Hii_mag .* exp(1j * Hii_phase_rad);


%% 5. Read transfer accelerances Hij

Hij = zeros(length(f),6);

for ii = 1:6

    % Construct filename
    filename = sprintf( ...
        'pim_in.pos1_acc.pos%d.dat', ii);

    filepath = fullfile(dataFolder, filename);

    % Read data
    [~, spectra] = readMWLdaq_LV(filepath, 'spectra');

    Hij_mag_data = spectra.sig_2_1_3OCT0;
    Hij_phase_data = spectra.sig_3_Phi0;
    
    % Magnitude at 1/3-octave frequencies
    Hij_freq = Hij_mag_data(:,1);
    Hij_mag = Hij_mag_data(:,2);

    % Phase at the same frequencies
    phase_freq = Hij_phase_data(:,1);
    phase_deg = Hij_phase_data(:,2);

    Hij_phase_deg = interp1(phase_freq, phase_deg, Hij_freq);

    % Convert phase from degrees to radians
    Hij_phase_rad = deg2rad(Hij_phase_deg);

    % Convert magnitude + phase to complex transfer function
    Hij_complex = Hij_mag .* exp(1j * Hij_phase_rad);

    % Keep only 125-5000 Hz
    Hij(:,ii) = Hij_complex(freqMask);

end

%% 6. Sum of transfer accelerances
%sumHij = sum(Hij, 2);
sumHij = sum(abs(Hij).^2, 2)

%% 7. Structural loss factor - power injection

%eta_pim = imag(Hii) ./ (ms .* sum(abs(Hij).^2, 2));
eta_pim = imag(Hii) ./ (ms .* sumHij);


%% 8. Plot structural loss factor - power injection

figure 
semilogx(f, eta_pim, 'o-')
xlabel('Frekvens [Hz]')
ylabel(' \eta')
title('PIM')
grid on

figure
semilogx(f, eta_pim, 'o-')
xlabel('Frequency [Hz]')
ylabel('\eta')
title('Structural loss factor - PIM')
grid on
xlim([125 5000])
%% 9. Read reverberation data

rmFolder = fullfile(fileparts(mfilename('fullpath')), ...
    'Labb2_riktig_data', 'rm');

dir(fullfile(rmFolder, '*.dat'));

%rmFiles = {'p1_1.dat', 'p1_2.dat', 'p1_3.dat'};
rmFiles = {'rm_1.2.dat', 'rm_1.3.dat', 'rm_1.5.dat','rm_1.6.dat','rm_3.1.dat'...
    'rm_3.4.dat','rm_3.5.dat','rm_3.6.dat','rm_6.1.dat','rm_6.2.dat','rm_6.3.dat','rm_6.4.dat'};

%% 10. Process reverberation measurements

Fs = 16000;

octfilt = octaveFilterBank('1/3 octave', Fs, ...
    'FrequencyRange', [125 5000], ...
    'FilterOrder', 12);

centerFrequencies = getCenterFrequencies(octfilt);
numBands = length(centerFrequencies);

numFiles = length(rmFiles);
eta_all = NaN(numFiles, numBands);

for k = 1:numFiles

    rmFile = fullfile(rmFolder, rmFiles{k});

    [~, ~, rmData] = readMWLdaq_LV(rmFile, 'rawdata');

raw_data = rmData{2}(:,2);

oct_data = octfilt(raw_data);

size(oct_data)

%% 11. Rolling mean average
at = 0.02;              % averaging window [s]
aS = round(at * Fs);    % averaging window [samples]

b = (1 / aS) * ones(1, aS);
a = 1;

mf_data = filter(b, a, abs(oct_data));

t = rmData{2}(:,1);


T60 = NaN(1, numBands);

for i = 1:numBands

    % Normalize level to 0 dB
    level_dB = 20*log10(mf_data(:,i) / max(mf_data(:,i)));

    % Find peak
    [maxLevel, idx_peak] = max(level_dB);
    t_peak = t(idx_peak);

    % Start fitting at -6 dB
    idx_start_relative = find( ...
        level_dB(idx_peak:end) <= maxLevel - 6, ...
        1, 'first');

    if isempty(idx_start_relative)
        continue
    end

    idx_start = idx_peak + idx_start_relative - 1;

    % Estimate noise floor
    noiseMask = t >= 5 & t <= 6;
    noiseFloor = median(level_dB(noiseMask));

    % End fitting 10 dB above noise floor
    endLevel = noiseFloor + 10;

    idx_end_relative = find( ...
        level_dB(idx_start:end) <= endLevel, ...
        1, 'first');

    if isempty(idx_end_relative)
        continue
    end

    idx_end = idx_start + idx_end_relative - 1;

    % Linear fit
    fitMask = t >= t(idx_start) & t <= t(idx_end);

    p = polyfit(t(fitMask), level_dB(fitMask), 1);

    slope = p(1);

    % Reverberation time
    T60(i) = -60 / slope;

end


% figure
% semilogx(centerFrequencies, T60, 'o-')
% xlabel('Frequency [Hz]')
% ylabel('T_{60} [s]')
% title('Reverberation time')
% grid on


eta = 2.2 ./ (centerFrequencies .* T60);
eta_all(k,:) = eta;
end

eta_mean = mean(eta_all, 1);
f_rm = centerFrequencies;

figure
semilogx(centerFrequencies, eta_mean, 'o-')
xlabel('Frequency [Hz]')
ylabel('\eta')
title('Mean loss factor from reverberation time')
grid on


figure

semilogx(f, eta_pim, 'o-', 'DisplayName', 'PIM')
hold on
semilogx(f_rm, eta_mean, 's-', 'DisplayName', 'RM')

xlabel('Frequency [Hz]')
ylabel('Structural loss factor, \eta')
title('Structural loss factor')
legend('Location', 'best')
grid on
xlim([125 5000])

%% 2-4. Read and calculate input accelerance Hii

% ---------------------------------------------------------
% Input accelerance: front
% ---------------------------------------------------------

inputFile_front = fullfile(dataFolder, ...
    'pim_input_acc_front.dat');

[~, inputSpectra_front] = readMWLdaq_LV(inputFile_front, 'spectra');

% Magnitude
Hii_mag_data_front = inputSpectra_front.sig_2_1_3OCT0;

% Phase
Hii_phase_data_front = inputSpectra_front.sig_3_Phi0;

% Frequency
Hii_freq_front = Hii_mag_data_front(:,1);
Hii_mag_front_all = Hii_mag_data_front(:,2);

% Phase frequency and phase
phase_freq_front = Hii_phase_data_front(:,1);
phase_deg_front = Hii_phase_data_front(:,2);

% Select 125-5000 Hz
freqMask_front = Hii_freq_front >= f_min & ...
                 Hii_freq_front <= f_max;

f = Hii_freq_front(freqMask_front);
Hii_mag_front = Hii_mag_front_all(freqMask_front);

% Interpolate phase to magnitude frequencies
Hii_phase_deg_front = interp1( ...
    phase_freq_front, ...
    phase_deg_front, ...
    f);

% Convert phase to radians
Hii_phase_rad_front = deg2rad(Hii_phase_deg_front);

% Convert magnitude + phase to complex Hii
Hii_front = Hii_mag_front .* ...
    exp(1j * Hii_phase_rad_front);


% ---------------------------------------------------------
% Input accelerance: back
% ---------------------------------------------------------

inputFile_back = fullfile(dataFolder, ...
    'pim_input_acc_back.dat');

[~, inputSpectra_back] = readMWLdaq_LV(inputFile_back, 'spectra');

% Magnitude
Hii_mag_data_back = inputSpectra_back.sig_2_1_3OCT0;

% Phase
Hii_phase_data_back = inputSpectra_back.sig_3_Phi0;

% Frequency
Hii_freq_back = Hii_mag_data_back(:,1);
Hii_mag_back_all = Hii_mag_data_back(:,2);

% Phase frequency and phase
phase_freq_back = Hii_phase_data_back(:,1);
phase_deg_back = Hii_phase_data_back(:,2);

% Select 125-5000 Hz
freqMask_back = Hii_freq_back >= f_min & ...
                Hii_freq_back <= f_max;

Hii_mag_back = Hii_mag_back_all(freqMask_back);

% Interpolate phase to magnitude frequencies
Hii_phase_deg_back = interp1( ...
    phase_freq_back, ...
    phase_deg_back, ...
    f);

% Convert phase to radians
Hii_phase_rad_back = deg2rad(Hii_phase_deg_back);

% Convert magnitude + phase to complex Hii
Hii_back = Hii_mag_back .* ...
    exp(1j * Hii_phase_rad_back);

%% Graf som visar input accelerance för baksida vs. framsida

figure;

semilogx(f, abs(Hii_front), 'o-', 'DisplayName', 'Opposite side');
hold on;
semilogx(f, abs(Hii_back), 's-', 'DisplayName', 'Beside force transducer');

xlabel('Frequency [Hz]');
ylabel('|H_{ii}| [m/s^2/N]');
title('Input accelerance');
legend('Location','best');
grid on;

%% Plot input accelerance phase

figure

semilogx(f, angle(Hii_front) * 180/pi, 'o-', ...
    'DisplayName', 'Opposite side')
hold on

semilogx(f, angle(Hii_back) * 180/pi, 's-', ...
    'DisplayName', 'Beside force transducer')

xlabel('Frequency [Hz]')
ylabel('Phase [degrees]')
title('Input accelerance phase')
legend('Location','best')
grid on
xlim([125 5000])

figure;

for ii = 1:6
    semilogx(f, abs(Hij(:,ii)), ...
        'DisplayName', sprintf('Position %d',ii));
    hold on;
end

xlabel('Frequency [Hz]');
ylabel('|H_{ij}| [m/s^2/N]');
title('Transfer accelerance at different positions');
legend('Location','best');
grid on;

% Sum of the complex transfer accelerances
sumHij = sum(Hij, 2);

% PIM using the two input accelerance measurements
eta_front = imag(Hii_front ./ (ms .* sumHij));
eta_back  = imag(Hii_back  ./ (ms .* sumHij));